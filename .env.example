# Outbound proxy for all live social collectors.
# Keep real proxy credentials, if any, in a local ignored .env or shell environment.
GLYPH_OUTBOUND_PROXY=http://127.0.0.1:7897

# Optional until a YouTube scope is started. Never commit a real key.
GLYPH_YOUTUBE_API_KEY=

# Restricted platforms remain empty until a separately approved live pilot.
GLYPH_MASTODON_ACCESS_TOKENS_JSON=
GLYPH_REDDIT_CLIENT_ID=
GLYPH_REDDIT_CLIENT_SECRET=
GLYPH_REDDIT_REFRESH_TOKEN=
GLYPH_REDDIT_USER_AGENT=
GLYPH_TIKTOK_CLIENT_KEY=
GLYPH_TIKTOK_CLIENT_SECRET=
GLYPH_X_BEARER_TOKEN=