      "option_set": "rating_1_7_na",
      "required": true,
      "response_type": "likert_1_7",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "Regardless of whether you recognize the writing, are the form's contours and structure visually clear?"
