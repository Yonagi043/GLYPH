        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "디자인 또는 타이포그래피 교육 수준은 어느 정도입니까?"
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "你的设计或字体排印训练程度是？"
        }
      }
    },
    {
      "construct": "calligraphy_training",
      "item_id": "item_calligraphy_training",
      "module": "training_exposure",
      "option_set": "training",
      "required": true,
      "response_type": "single_choice",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "What is your level of calligraphy or lettering-arts training?"
