        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "書道または文字芸術の訓練経験はどの程度ですか。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "서예 또는 레터링 예술 교육 수준은 어느 정도입니까?"
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "你的书法或文字艺术训练程度是？"
        }
      }
    },
    {
      "construct": "device_calibration",
      "item_id": "item_device_ready",
      "module": "device_practice",
      "option_set": "yes_no",
      "required": true,
      "response_type": "single_choice",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "Is the image fully visible, with screen brightness and surroundings suitable for viewing?"
