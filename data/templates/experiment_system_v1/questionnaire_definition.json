      "required": true,
      "response_type": "likert_1_7",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "Overall, is this visual form aesthetically pleasing?"
        },
        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "全体として、この視覚形式は美しいですか。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "전반적으로 이 시각적 형태가 아름답습니까?"
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "整体上，这个视觉形式美观吗？"
        }
      }
    },
