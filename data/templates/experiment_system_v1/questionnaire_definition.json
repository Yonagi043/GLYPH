{
  "items": [
    {
      "construct": "study_information",
      "item_id": "item_study_information",
      "module": "information_consent",
      "option_set": null,
      "required": true,
      "response_type": "information",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "This study compares perceptions of visual forms across writing systems. This version is for synthetic engineering tests only and does not collect real-person data."
        },
        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "本研究は異なる文字体系の視覚形式に対する知覚を比較します。現在の版は合成工学テスト専用で、実在する参加者のデータは収集しません。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "이 연구는 문자 체계별 시각적 형태에 대한 인식을 비교합니다. 현재 버전은 합성 엔지니어링 테스트 전용이며 실제 참여자 데이터를 수집하지 않습니다."
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "本研究比较不同文字视觉形式的感知。当前版本仅用于合成工程测试，不收集真人数据。"
        }
      }
    },
    {
      "construct": "consent",
      "item_id": "item_consent",
      "module": "information_consent",
      "option_set": "consent",
      "required": true,
      "response_type": "consent",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "I have read the study information and agree to participate under the stated conditions."
        },
        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "研究情報を読み、記載された条件で参加することに同意します。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "연구 정보를 읽었으며 명시된 조건에 따라 참여하는 데 동의합니다."
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "我已阅读研究信息，并同意按所示条件参加。"
        }
      }
    },
    {
      "construct": "age_eligibility",
      "item_id": "item_age_eligible",
      "module": "eligibility",
      "option_set": "yes_no",
      "required": true,
      "response_type": "single_choice",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "Do you meet the minimum participation age approved by ethics review?"
        },
        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "倫理審査で承認された最低参加年齢に達していますか。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "윤리 심의에서 승인된 최소 참여 연령을 충족합니까?"
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "你是否达到经伦理批准的最低参与年龄？"
        }
      }
    },
    {
      "construct": "questionnaire_language_comprehension",
      "item_id": "item_language_understood",
      "module": "eligibility",
      "option_set": "yes_no",
      "required": true,
      "response_type": "single_choice",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "Can you understand the current questionnaire language well enough?"
        },
        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "現在の質問票の言語を十分に理解できますか。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "현재 설문 언어를 충분히 이해할 수 있습니까?"
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "你是否能够充分理解当前问卷语言？"
        }
      }
    },
    {
      "construct": "mother_tongues",
      "item_id": "item_mother_tongues",
      "module": "language_scripts",
      "option_set": "languages",
      "required": true,
      "response_type": "multi_choice",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "Select your mother tongue(s); you may select more than one and separately mark the primary language."
        },
        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "母語を選択してください。複数選択でき、主要言語は別に示します。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "모국어를 선택하십시오. 여러 개를 선택할 수 있으며 주 언어는 별도로 표시합니다."
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "请选择你的母语；可多选，并另行标注主要语言。"
        }
      }
    },
    {
      "construct": "native_scripts",
      "item_id": "item_native_scripts",
      "module": "language_scripts",
      "option_set": "scripts",
      "required": true,
      "response_type": "multi_choice",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "Select the writing system(s) you have used proficiently since childhood; multiple selections are allowed."
        },
        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "幼少期から習熟して使用している文字体系を選択してください。複数選択できます。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "어릴 때부터 능숙하게 사용한 문자 체계를 선택하십시오. 복수 선택이 가능합니다."
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "请选择你从小熟练使用的文字系统；可多选。"
        }
      }
    },
    {
      "construct": "script_reading_writing_exposure",
      "item_id": "item_script_proficiency",
      "module": "language_scripts",
      "option_set": "proficiency_1_7",
      "required": true,
      "response_type": "single_choice",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "Rate reading, writing and exposure frequency separately for Latin, Han, Kana and Hangul."
        },
        "ja": {
          "review_status": "translated_draft_unreviewed",
          "text": "ラテン文字、漢字、仮名、ハングルについて、読む力、書く力、接触頻度を別々に評価してください。"
        },
        "ko": {
          "review_status": "translated_draft_unreviewed",
          "text": "라틴, 한자, 가나, 한글 각각에 대해 읽기, 쓰기, 노출 빈도를 평가하십시오."
        },
        "zh-Hans": {
          "review_status": "source_draft",
          "text": "请分别评价你对拉丁、汉字、假名和韩文的阅读、书写与接触频率。"
        }
      }
    },
    {
      "construct": "design_typography_training",
      "item_id": "item_design_training",
      "module": "training_exposure",
      "option_set": "training",
      "required": true,
      "response_type": "single_choice",
      "translations": {
        "en": {
          "review_status": "translated_draft_unreviewed",
          "text": "What is your level of design or typography training?"
