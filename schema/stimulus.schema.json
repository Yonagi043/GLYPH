{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH stimulus manifest record",
  "description": "The immutable, shared record for one rendered or source wordmark stimulus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stimulus_id", "research_lines", "writing_system", "script_name", "style_family", "content_set", "render_profile", "text", "font", "canvas", "foreground_rgba", "ink_area_target_ratio", "layout", "shaping", "anchors", "readability", "provenance", "assets", "qc"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1.0" },
    "stimulus_id": { "$ref": "shared.schema.json#/$defs/stimulusId" },
    "study_id": { "$ref": "shared.schema.json#/$defs/id" },
    "research_lines": { "type": "array", "items": { "$ref": "shared.schema.json#/$defs/researchLine" }, "minItems": 1, "uniqueItems": true },
    "writing_system": { "$ref": "shared.schema.json#/$defs/writingSystem" },
    "script_code_iso15924": { "type": ["string", "null"], "pattern": "^[A-Z][a-z]{3}$" },
    "script_name": { "type": "string", "minLength": 1 },
    "style_family": { "$ref": "shared.schema.json#/$defs/styleFamily" },
    "content_set": { "type": "object", "additionalProperties": false, "required": ["content_set_id", "unit_count", "semantic_status"], "properties": { "content_set_id": { "type": "string" }, "unit_count": { "type": "integer", "minimum": 1 }, "semantic_status": { "$ref": "shared.schema.json#/$defs/semanticStatus" } } },
    "render_profile": { "type": "string", "enum": ["bbox_height_matched", "ink_area_matched"] },
    "style_name": { "type": ["string", "null"] },
    "text": { "$ref": "shared.schema.json#/$defs/text" },
    "font": { "$ref": "shared.schema.json#/$defs/font" },
    "canvas": { "$ref": "shared.schema.json#/$defs/canvas" },
    "foreground_rgba": { "$ref": "shared.schema.json#/$defs/rgba" },
    "ink_area_target_ratio": { "type": "number", "minimum": 0, "maximum": 1, "description": "Target proportion of canvas occupied by rendered ink; measured ratio belongs in visual_features." },
    "layout": { "$ref": "shared.schema.json#/$defs/layout" },
    "shaping": { "type": "object", "additionalProperties": false, "required": ["engine", "language", "features", "unicode_normalization", "hinting"], "properties": { "engine": { "type": "string" }, "language": { "type": "string" }, "features": { "type": "array", "items": { "type": "string" } }, "unicode_normalization": { "const": "NFC" }, "hinting": { "type": "string" } } },
    "anchors": { "type": "object", "additionalProperties": false, "required": ["single_ink_bbox_center", "multi_text_center_x", "multi_baseline_y"], "properties": { "single_ink_bbox_center": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"}], "items": false }, "multi_text_center_x": { "type": "number" }, "multi_baseline_y": { "type": "number" } } },
    "readability": { "$ref": "shared.schema.json#/$defs/readability" },
    "brand_context": { "type": ["string", "null"] },
    "semantic_control": { "type": "string", "enum": ["same_content_across_fonts", "matched_translation", "unrelated_content", "content_not_controlled", "unknown"] },
    "provenance": { "$ref": "shared.schema.json#/$defs/provenance" },
    "assets": { "type": "object", "additionalProperties": false, "required": ["rendered"], "properties": { "rendered": { "$ref": "shared.schema.json#/$defs/assetRef" }, "source": { "anyOf": [{ "$ref": "shared.schema.json#/$defs/assetRef" }, { "type": "null" }] } } },
    "qc": { "type": "object", "additionalProperties": false, "required": ["status", "checked_at"], "properties": { "status": { "type": "string", "enum": ["pending", "passed", "failed", "needs_review"] }, "checked_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" }, "reviewer": { "type": ["string", "null"] }, "notes": { "type": ["string", "null"] } } }
  }
}
