{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH Han knowledge claim record",
  "description": "A sourced assertion. Historical knowledge, formal description, cultural association, and protocol boundaries remain distinct domains.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "claim_domain",
    "claim_type",
    "subject_type",
    "subject_id",
    "relation",
    "object_id",
    "object_value",
    "source_id",
    "source_locator",
    "evidence_span",
    "original_language_bcp47",
    "translation",
    "evidence_grade",
    "confidence",
    "uncertainty",
    "extraction_method",
    "verification_status",
    "human_reviewer_id",
    "stance"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "claim_id": { "$ref": "shared.schema.json#/$defs/id" },
    "claim_domain": {
      "type": "string",
      "enum": ["historical_knowledge", "formal_description", "cultural_association", "protocol_boundary"]
    },
    "claim_type": {
      "type": "string",
      "enum": ["definition", "period", "attribution", "evolution", "form_description", "usage_context", "cultural_association", "object_boundary"]
    },
    "subject_type": {
      "type": "string",
      "enum": ["style_concept", "glyph_instance", "work", "font_instance", "stimulus_candidate"]
    },
    "subject_id": { "$ref": "shared.schema.json#/$defs/id" },
    "relation": { "type": "string", "minLength": 1 },
    "object_id": {
      "anyOf": [{ "$ref": "shared.schema.json#/$defs/id" }, { "type": "null" }]
    },
    "object_value": { "type": ["string", "null"] },
    "source_id": { "$ref": "shared.schema.json#/$defs/id" },
    "source_locator": { "type": "string", "minLength": 1 },
    "evidence_span": { "type": "string", "minLength": 1 },
    "original_language_bcp47": { "type": "string", "minLength": 2 },
    "translation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "language_bcp47", "review_status"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "language_bcp47": { "type": "string", "minLength": 2 },
            "review_status": { "type": "string", "enum": ["machine_candidate", "human_verified", "rejected"] }
          }
        },
        { "type": "null" }
      ]
    },
    "evidence_grade": { "type": "string", "enum": ["A", "B", "C", "D", "fixture"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty": { "type": "string", "minLength": 1 },
    "extraction_method": { "type": "string", "enum": ["manual", "llm_candidate", "protocol_fixture"] },
    "verification_status": { "type": "string", "enum": ["candidate", "human_verified", "rejected", "disputed", "fixture_only"] },
    "human_reviewer_id": {
      "anyOf": [{ "$ref": "shared.schema.json#/$defs/id" }, { "type": "null" }]
    },
    "stance": { "type": "string", "enum": ["supports", "opposes", "qualifies", "not_applicable"] }
  },
  "allOf": [
    {
      "if": { "properties": { "claim_domain": { "const": "cultural_association" } }, "required": ["claim_domain"] },
      "then": { "properties": { "claim_type": { "const": "cultural_association" } } }
    },
    {
      "if": { "properties": { "claim_type": { "const": "cultural_association" } }, "required": ["claim_type"] },
      "then": { "properties": { "claim_domain": { "const": "cultural_association" } } }
    },
    {
      "if": { "properties": { "verification_status": { "const": "human_verified" } }, "required": ["verification_status"] },
      "then": { "properties": { "human_reviewer_id": { "$ref": "shared.schema.json#/$defs/id" } } }
    },
    {
      "if": { "properties": { "verification_status": { "const": "fixture_only" } }, "required": ["verification_status"] },
      "then": { "properties": { "extraction_method": { "const": "protocol_fixture" }, "evidence_grade": { "const": "fixture" } } }
    }
  ],
  "anyOf": [
    { "required": ["object_id"], "properties": { "object_id": { "$ref": "shared.schema.json#/$defs/id" } } },
    { "required": ["object_value"], "properties": { "object_value": { "type": "string", "minLength": 1 } } }
  ]
}