{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH workbench human gate decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_decision_id", "gate_id", "status", "scope", "decider_ref", "evidence_artifact_ids", "decided_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "gate_decision_id": { "type": "string", "pattern": "^gatedec_[a-f0-9]{24}$" },
    "gate_id": { "enum": ["GATE-RIGHTS", "GATE-HISTORY", "GATE-ETHICS", "GATE-PARTICIPANTS", "GATE-EXPERT", "GATE-TERMS", "GATE-RELEASE"] },
    "status": { "enum": ["blocked", "approved", "expired", "revoked"] },
    "scope": { "type": "string", "minLength": 1 },
    "decider_ref": { "type": ["string", "null"] },
    "evidence_artifact_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "decided_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
      "then": {
        "properties": {
          "decider_ref": { "type": "string", "minLength": 1 },
          "evidence_artifact_ids": { "minItems": 1 }
        }
      }
    }
  ]
}