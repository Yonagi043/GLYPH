{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH normalized public-social observation",
  "description": "One normalized public item collected for the cultural-narrative line. It records an observable sample, not total traffic, public opinion, causal influence, or aesthetic truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "collection_run_id",
    "platform",
    "platform_item_id",
    "source_id",
    "url",
    "source_kind",
    "collected_at",
    "text",
    "content_status",
    "engagement",
    "annotation_status",
    "aesthetic_terms",
    "brand_context",
    "governance",
    "normalization"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.1.0", "0.2.0"] },
    "observation_id": {
      "type": "string",
      "pattern": "^obs_[a-z0-9][a-z0-9_-]{2,127}$",
      "description": "Stable hash-derived identity for one platform item observed in one collection run; the run is part of the identity so repeated captures remain distinct."
    },
    "collection_run_id": {
      "type": "string",
      "pattern": "^social_run_[a-z0-9][a-z0-9_-]{2,127}$"
    },
    "platform": {
      "type": "string",
      "enum": ["reddit", "youtube", "x", "bluesky", "mastodon", "instagram", "tiktok", "douyin", "xiaohongshu", "pinterest", "bilibili", "telegram", "public_web", "manual_capture", "google_trends", "other"]
    },
    "platform_item_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source_id": { "$ref": "shared.schema.json#/$defs/id" },
    "url": { "$ref": "shared.schema.json#/$defs/uri" },
    "source_kind": {
      "type": "string",
      "enum": ["official_api", "public_web", "manual_capture", "browser_capture", "imported_export"]
    },
    "query_id": {
      "anyOf": [
        { "type": "string", "pattern": "^q_[a-z0-9][a-z0-9_-]{2,127}$" },
        { "type": "null" }
      ]
    },
    "query_text": { "type": ["string", "null"], "maxLength": 2000 },
    "published_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "collected_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" },
    "language_bcp47": {
      "anyOf": [
        { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        { "type": "null" }
      ]
    },
    "region_hint": { "type": ["string", "null"], "maxLength": 128 },
    "title": { "type": ["string", "null"], "maxLength": 10000 },
    "text": {
      "type": "string",
      "maxLength": 200000,
      "description": "Text visible to the collector; it may be empty for image-only or deleted items."
    },
    "content_status": {
      "type": "string",
      "enum": ["available", "image_only", "video_only", "deleted", "private", "unreachable", "unknown"],
      "description": "What the collector could access at collection time. This distinguishes an empty text field from a missing or deleted item."
    },
    "author_ref": {
      "anyOf": [
        { "type": "string", "pattern": "^author_[a-z0-9][a-z0-9_-]{7,127}$" },
        { "type": "null" }
      ],
      "description": "Optional opaque reference. Do not publish usernames, display names, emails, or unsalted platform IDs."
    },
    "author_role": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["brand", "design_studio", "designer", "design_media", "researcher", "ordinary_user", "creator", "unknown"]
        },
        { "type": "null" }
      ]
    },
    "writing_system": {
      "anyOf": [
        { "$ref": "shared.schema.json#/$defs/writingSystem" },
        { "type": "null" }
      ]
    },
    "style_family": {
      "anyOf": [
        { "$ref": "shared.schema.json#/$defs/styleFamily" },
        { "type": "null" }
      ]
    },
    "object_type": {
      "anyOf": [
        { "type": "string", "enum": ["writing_system", "script", "style_family", "font", "stimulus", "brand"] },
        { "type": "null" }
      ]
    },
    "object_label": { "type": ["string", "null"], "maxLength": 256 },
    "stimulus_id": {
      "anyOf": [
        { "$ref": "shared.schema.json#/$defs/stimulusId" },
        { "type": "null" }
      ]
    },
    "font_id": {
      "anyOf": [
        { "$ref": "shared.schema.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "aesthetic_terms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true,
      "maxItems": 64
    },
    "brand_context": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true,
      "maxItems": 32
    },
    "stance": {
      "anyOf": [
        { "type": "string", "enum": ["positive", "negative", "mixed", "descriptive", "counterexample", "unclear"] },
        { "type": "null" }
      ]
    },
    "mechanism_claim": { "type": ["string", "null"], "maxLength": 5000 },
    "evidence_span": {
      "type": ["string", "null"],
      "maxLength": 10000,
      "description": "Exact, human-checkable text supporting the annotation; never an AI-only paraphrase."
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["like_count", "comment_count", "share_count", "quote_count", "view_count", "score", "observed_at", "is_public"],
      "properties": {
        "like_count": { "type": ["integer", "null"], "minimum": 0 },
        "comment_count": { "type": ["integer", "null"], "minimum": 0 },
        "share_count": { "type": ["integer", "null"], "minimum": 0 },
        "quote_count": { "type": ["integer", "null"], "minimum": 0 },
        "view_count": { "type": ["integer", "null"], "minimum": 0 },
        "score": { "type": ["integer", "null"], "minimum": -2147483648 },
        "observed_at": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "is_public": { "type": "boolean" }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation", "target_item_id"],
        "properties": {
          "relation": { "type": "string", "enum": ["reply", "repost", "quote", "mention", "link", "parent", "unknown"] },
          "target_item_id": { "type": "string", "minLength": 1, "maxLength": 512 },
          "target_url": {
            "anyOf": [
              { "type": "string", "format": "uri" },
              { "type": "null" }
            ]
          }
        }
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "annotation_status": {
      "type": "string",
      "enum": ["unannotated", "candidate", "human_verified", "excluded"]
    },
    "annotator_ref": {
      "anyOf": [
        { "type": "string", "pattern": "^annotator_[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
        { "type": "null" }
      ]
    },
    "human_verified_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "annotation_confidence": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ],
      "description": "Optional reviewer confidence in the annotation, not a probability that the narrative is true. Keep null until a reviewer assigns it."
    },
    "exclusion_reason": { "type": ["string", "null"], "maxLength": 1000 },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_handling", "raw_payload_status", "redistribution_status"],
      "properties": {
        "author_handling": { "type": "string", "enum": ["not_collected", "opaque_hash", "local_only"] },
        "raw_payload_status": { "type": "string", "enum": ["not_stored", "local_only", "stored"] },
        "redistribution_status": { "type": "string", "enum": ["metadata_only", "derived_only", "permitted"] },
        "terms_checked_at": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "notes": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizer_version", "input_sha256", "record_sha256", "normalized_at"],
      "properties": {
        "normalizer_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "normalized_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "description": "Non-analytic adapter metadata. Values must not contain direct personal data.",
      "properties": {
        "adapter_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true,
          "maxItems": 100
        },
        "media_type": { "type": ["string", "null"], "maxLength": 128 },
        "is_deleted": { "type": ["boolean", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "platform": { "const": "mastodon" } }, "required": ["platform"] },
      "then": { "properties": { "schema_version": { "const": "0.2.0" } } }
    },
    {
      "if": { "properties": { "annotation_status": { "const": "human_verified" } }, "required": ["annotation_status"] },
      "then": {
        "required": ["evidence_span", "human_verified_at", "annotator_ref", "object_type", "object_label"],
        "properties": {
          "evidence_span": { "type": "string", "minLength": 1 },
          "human_verified_at": { "type": "string", "format": "date-time" },
          "annotator_ref": { "type": "string", "pattern": "^annotator_[A-Za-z0-9][A-Za-z0-9_-]{1,127}$" },
          "object_type": { "type": "string" },
          "object_label": { "type": "string", "minLength": 1 },
          "aesthetic_terms": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "annotation_status": { "const": "excluded" } }, "required": ["annotation_status"] },
      "then": {
        "required": ["exclusion_reason"],
        "properties": { "exclusion_reason": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
