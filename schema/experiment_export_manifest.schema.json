{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH deidentified experiment export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "purpose", "synthetic_only", "data_origins", "quality_rule_version", "artifacts"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "study_id": { "$ref": "shared.schema.json#/$defs/id" },
    "purpose": { "type": "string", "enum": ["engineering_fixture", "formal_analysis", "release"] },
    "synthetic_only": { "type": "boolean" },
    "data_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["synthetic", "real"] }
    },
    "quality_rule_version": { "const": "1.0.0" },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_type", "path", "schema", "schema_version", "record_count", "sha256"],
        "properties": {
          "record_type": { "type": "string", "enum": ["profiles", "consents", "assignments", "presentations", "ratings", "quality_decisions"] },
          "path": { "type": "string", "pattern": "^[a-z_]+\\.jsonl$" },
          "schema": { "type": "string", "pattern": "^[a-z_]+\\.schema\\.json$" },
          "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "record_count": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}