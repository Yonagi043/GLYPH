{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH cross-cultural study protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "protocol_version",
    "title",
    "status",
    "synthetic_only",
    "research_questions",
    "hypotheses",
    "design",
    "outcomes",
    "sampling_plan",
    "randomization",
    "exclusion_rules",
    "analysis_plan",
    "measurement_invariance",
    "human_gates",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "study_id": { "$ref": "shared.schema.json#/$defs/id" },
    "protocol_version": { "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "engineering_fixture_frozen" },
    "synthetic_only": { "const": true },
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "statement", "estimand", "analysis_class"],
        "properties": {
          "hypothesis_id": { "type": "string", "pattern": "^H[0-9]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "estimand": { "type": "string", "minLength": 1 },
          "analysis_class": { "type": "string", "enum": ["confirmatory", "exploratory"] }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation_condition", "target_script_groups", "block_size", "anchor_count", "max_consecutive_same_script"],
      "properties": {
        "presentation_condition": { "const": "visual_blind" },
        "target_script_groups": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["latin", "han", "kana", "hangul"] }
        },
        "block_size": { "type": "integer", "minimum": 4, "maximum": 40 },
        "anchor_count": { "type": "integer", "minimum": 1 },
        "max_consecutive_same_script": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["aesthetic", "premium", "modern", "trustworthy"] }
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["visual_clarity", "recognition", "unfamiliarity", "brand_fit"] }
        }
      }
    },
    "sampling_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quota_basis", "power_scenarios", "sample_size_status"],
      "properties": {
        "quota_basis": { "const": "self_reported_native_scripts_not_nationality" },
        "power_scenarios": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["standardized_effect", "participant_icc", "stimulus_icc"],
            "properties": {
              "standardized_effect": { "type": "number", "exclusiveMinimum": 0 },
              "participant_icc": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
              "stimulus_icc": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
            }
          }
        },
        "sample_size_status": { "const": "scenario_only_pending_participant_gate" }
      }
    },
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "seed_namespace", "balance_tolerance", "resume_policy"],
      "properties": {
        "algorithm": { "const": "balanced_incomplete_block_v1" },
        "seed_namespace": { "type": "string", "minLength": 1 },
        "balance_tolerance": { "type": "integer", "minimum": 0 },
        "resume_policy": { "const": "persist_assignment_and_resume_next_unsubmitted_presentation" }
      }
    },
    "exclusion_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rules", "outcome_blind"],
      "properties": {
        "version": { "const": "1.0.0" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "criterion", "action"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
              "criterion": { "type": "string", "minLength": 1 },
              "action": { "const": "flag_preserve_raw" }
            }
          }
        },
        "outcome_blind": { "const": true }
      }
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_model", "participant_effect", "stimulus_effect", "interaction", "multiple_comparisons", "missingness", "confirmatory_frozen"],
      "properties": {
        "primary_model": { "const": "ordinal_mixed_effects" },
        "participant_effect": { "const": "random_intercept" },
        "stimulus_effect": { "const": "random_intercept" },
        "interaction": { "const": "native_script_x_stimulus_script" },
        "multiple_comparisons": { "type": "string", "minLength": 1 },
        "missingness": { "const": "preserve_reason_never_zero_impute" },
        "confirmatory_frozen": { "const": true }
      }
    },
    "measurement_invariance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_before_cross_language_comparison", "sequence", "current_status"],
      "properties": {
        "required_before_cross_language_comparison": { "const": true },
        "sequence": {
          "type": "array",
          "prefixItems": [{ "const": "configural" }, { "const": "metric" }, { "const": "scalar" }],
          "items": false
        },
        "current_status": { "const": "not_tested_no_real_participants" }
      }
    },
    "human_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GATE-ETHICS", "GATE-PARTICIPANTS", "GATE-TRANSLATION"],
      "properties": {
        "GATE-ETHICS": { "const": "blocked" },
        "GATE-PARTICIPANTS": { "const": "blocked" },
        "GATE-TRANSLATION": { "const": "blocked" }
      }
    },
    "created_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" }
  }
}