{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH minimal consent receipt",
  "description": "Records consent state only; signatures, names, contact and compensation data belong in a separate restricted system.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "participant_id", "data_origin", "consent_version", "status", "age_eligible", "recorded_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "study_id": { "$ref": "shared.schema.json#/$defs/id" },
    "participant_id": { "type": "string" },
    "data_origin": { "type": "string", "enum": ["synthetic", "real"] },
    "consent_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "type": "string", "enum": ["consented", "declined", "withdrawn"] },
    "age_eligible": { "type": "boolean" },
    "recorded_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" }
  },
  "allOf": [
    {
      "if": { "properties": { "data_origin": { "const": "synthetic" } }, "required": ["data_origin"] },
      "then": { "properties": { "participant_id": { "pattern": "^synp_[a-z0-9_-]{4,63}$" } } },
      "else": { "properties": { "participant_id": { "pattern": "^p_[A-Za-z0-9_-]{2,63}$" } } }
    }
  ]
}