{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH human rating record",
  "description": "One participant's response to one stimulus. Participant identity must remain pseudonymous.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rating_id", "study_id", "stimulus_id", "participant_id", "trial_index", "respondent_language_bcp47", "native_script", "rating_scale", "ratings", "attention_check_passed", "collected_at"],
  "properties": {
    "rating_id": { "$ref": "shared.schema.json#/$defs/id" },
    "study_id": { "$ref": "shared.schema.json#/$defs/id" },
    "stimulus_id": { "$ref": "shared.schema.json#/$defs/stimulusId" },
    "participant_id": { "type": "string", "pattern": "^p_[A-Za-z0-9_-]{2,63}$" },
    "trial_index": { "type": "integer", "minimum": 1 },
    "respondent_language_bcp47": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "native_script": { "$ref": "shared.schema.json#/$defs/writingSystem" },
    "self_reported_familiarity": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 },
    "rating_scale": { "type": "string", "enum": ["likert_1_7", "likert_1_5", "continuous_0_100"] },
    "ratings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "aesthetic": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "premium": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "modern": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "trustworthy": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "legibility": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "unfamiliarity": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "brand_fit": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "minProperties": 1
    },
    "response_time_ms": { "type": ["integer", "null"], "minimum": 0 },
    "attention_check_passed": { "type": "boolean" },
    "exclude_from_analysis": { "type": "boolean", "default": false },
    "exclusion_reason": { "type": ["string", "null"] },
    "collected_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" }
  }
}
