{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH long-form visual measurement record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measurement_id",
    "feature_record_id",
    "stimulus_id",
    "asset_id",
    "extraction_run_id",
    "representation",
    "normalization_profile",
    "feature_code",
    "feature_definition_version",
    "value",
    "numerator",
    "denominator",
    "unit",
    "applicability",
    "measurement_status",
    "missing_code",
    "algorithm_config_sha256",
    "input_sha256",
    "computed_at",
    "software_environment_sha256",
    "source_contract_sha256",
    "dimensions",
    "constructs",
    "fixture_only",
    "legacy_v1_context"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "measurement_id": {"type": "string", "pattern": "^measurement_[a-f0-9]{24}$"},
    "feature_record_id": {"type": "string", "pattern": "^feature_[a-f0-9]{24}$"},
    "stimulus_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "extraction_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "representation": {"enum": ["A_layout", "B_shape", "C_ink", "raster_binary", "raster_grayscale", "contour", "skeleton"]},
    "normalization_profile": {"enum": ["task01_frozen", "bbox_height_matched", "ink_area_matched"]},
    "feature_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "feature_definition_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "value": {"type": ["number", "null"]},
    "numerator": {"type": ["number", "null"]},
    "denominator": {"type": ["number", "null"]},
    "unit": {"enum": ["ratio", "count", "normalized_length", "bits"]},
    "applicability": {"enum": ["direct", "protocol_dependent", "within_script_only", "not_applicable"]},
    "measurement_status": {"enum": ["valid", "missing", "needs_review"]},
    "missing_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"},
    "algorithm_config_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "computed_at": {"type": "string", "format": "date-time"},
    "software_environment_sha256": {"$ref": "#/$defs/sha256"},
    "source_contract_sha256": {"$ref": "#/$defs/sha256"},
    "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "constructs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "fixture_only": {"type": "boolean"},
    "legacy_v1_context": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/legacyV1Context"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"measurement_status": {"const": "valid"}}},
      "then": {"properties": {"value": {"type": "number"}, "missing_code": {"type": "null"}}}
    },
    {
      "if": {"properties": {"measurement_status": {"const": "missing"}}},
      "then": {"properties": {"value": {"type": "null"}, "missing_code": {"type": "string"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "legacyV1Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_row_index", "source_feature_record_id", "dimensions", "applicability",
        "measurement_status", "missing_reason", "feature_numerators", "feature_denominators",
        "feature_units", "feature_applicability", "missing_reasons"
      ],
      "properties": {
        "source_row_index": {"type": "integer", "minimum": 0},
        "source_feature_record_id": {"type": "string", "minLength": 1},
        "dimensions": {"type": "array", "items": {"type": "string"}},
        "applicability": {"enum": ["direct", "protocol_dependent", "within_script_only", "not_applicable"]},
        "measurement_status": {"enum": ["valid", "missing", "needs_review"]},
        "missing_reason": {"type": ["string", "null"]},
        "feature_numerators": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
        "feature_denominators": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
        "feature_units": {"type": "object", "additionalProperties": {"type": "string"}},
        "feature_applicability": {"type": "object", "additionalProperties": {"enum": ["direct", "protocol_dependent", "within_script_only", "not_applicable"]}},
        "missing_reasons": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}