{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH Han style concept record",
  "description": "A controlled concept record. It is not a font, glyph, work, historical claim, association claim, or expert decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "style_id",
    "target_code",
    "canonical_names",
    "historical_names",
    "aliases",
    "classification_level",
    "broader_style_ids",
    "historical_period",
    "regions",
    "typical_media",
    "usage_contexts",
    "definition_source_ids",
    "record_status",
    "human_review_status"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "style_id": { "$ref": "shared.schema.json#/$defs/id" },
    "target_code": {
      "type": "string",
      "enum": ["small_seal", "clerical", "regular", "running", "cursive", "song", "sans", "slender_gold"]
    },
    "canonical_names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-Hans", "en"],
      "properties": {
        "zh-Hans": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "historical_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "language_bcp47", "alias_type"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "language_bcp47": { "type": "string", "minLength": 2 },
          "alias_type": { "type": "string", "enum": ["controlled", "historical", "transliteration", "colloquial"] }
        }
      }
    },
    "classification_level": {
      "type": "string",
      "enum": ["historical_script", "calligrapher_style", "print_type_category", "modern_digital_category"]
    },
    "broader_style_ids": {
      "type": "array",
      "items": { "$ref": "shared.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "historical_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "start_year", "end_year", "uncertainty"],
      "properties": {
        "label": { "type": ["string", "null"] },
        "start_year": { "type": ["integer", "null"] },
        "end_year": { "type": ["integer", "null"] },
        "uncertainty": { "type": "string", "enum": ["exact", "approximate", "disputed", "unknown"] }
      }
    },
    "regions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "typical_media": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "usage_contexts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "definition_source_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "shared.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "record_status": { "type": "string", "enum": ["candidate", "verified", "deprecated"] },
    "human_review_status": { "type": "string", "enum": ["pending", "passed", "failed", "needs_revision"] }
  }
}