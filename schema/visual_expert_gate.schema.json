{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH TASK-02 expert review gate packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "status",
    "decision_required",
    "minimum_reviewers",
    "reviewer_requirements",
    "materials",
    "review_questions",
    "decision_template",
    "allowed_now",
    "prohibited_without_approval"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "gate_id": {"const": "GATE-EXPERT"},
    "status": {"const": "blocked"},
    "decision_required": {"type": "string", "minLength": 1},
    "minimum_reviewers": {"const": 2},
    "reviewer_requirements": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "materials": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_type", "path", "sha256"],
        "properties": {
          "logical_type": {"type": "string", "minLength": 1},
          "path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "review_questions": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_decisions", "final_status", "notes"],
      "properties": {
        "reviewer_decisions": {"type": "array", "maxItems": 0},
        "final_status": {"const": "pending"},
        "notes": {"const": null}
      }
    },
    "allowed_now": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "prohibited_without_approval": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    }
  }
}