{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH Han expert review package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "created_at",
    "review_round",
    "subject_type",
    "item_manifest",
    "package_content_sha256",
    "item_count",
    "rubric_dimensions",
    "blinding",
    "asset_access_level",
    "gate_status",
    "gate_approval_id"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "package_id": { "$ref": "shared.schema.json#/$defs/id" },
    "package_version": { "type": "string", "const": "1.0.0" },
    "created_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" },
    "review_round": { "type": "integer", "minimum": 1 },
    "subject_type": { "type": "string", "const": "glyph_instance" },
    "item_manifest": { "$ref": "shared.schema.json#/$defs/assetRef" },
    "package_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "item_count": { "type": "integer", "minimum": 1 },
    "rubric_dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_reviews_hidden", "style_labels_withheld", "reviewer_answers_separate"],
      "properties": {
        "prior_reviews_hidden": { "const": true },
        "style_labels_withheld": { "const": true },
        "reviewer_answers_separate": { "const": true }
      }
    },
    "asset_access_level": { "type": "string", "enum": ["open_fixture", "research_local_only"] },
    "gate_status": { "type": "string", "enum": ["blocked", "approved"] },
    "gate_approval_id": {
      "anyOf": [{ "$ref": "shared.schema.json#/$defs/id" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "gate_status": { "const": "approved" } }, "required": ["gate_status"] },
      "then": { "properties": { "gate_approval_id": { "$ref": "shared.schema.json#/$defs/id" } } },
      "else": { "properties": { "gate_approval_id": { "type": "null" } } }
    }
  ]
}