{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH blinded Han review item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_item_id",
    "subject_type",
    "subject_id",
    "blinded_subject_code",
    "display_order",
    "character_display",
    "fixture_disclaimer",
    "source_asset",
    "candidate_asset",
    "difference_overlay_available",
    "disclosed_metadata",
    "withheld_metadata",
    "rights_tier",
    "access_status"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "review_item_id": { "$ref": "shared.schema.json#/$defs/id" },
    "subject_type": { "type": "string", "const": "glyph_instance" },
    "subject_id": { "$ref": "shared.schema.json#/$defs/id" },
    "blinded_subject_code": { "$ref": "shared.schema.json#/$defs/id" },
    "display_order": { "type": "integer", "minimum": 1 },
    "character_display": { "type": "string", "minLength": 1 },
    "fixture_disclaimer": { "type": ["string", "null"] },
    "source_asset": { "$ref": "shared.schema.json#/$defs/assetRef" },
    "candidate_asset": { "$ref": "shared.schema.json#/$defs/assetRef" },
    "difference_overlay_available": { "type": "boolean" },
    "disclosed_metadata": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "withheld_metadata": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rights_tier": { "type": "string", "enum": ["open", "research_local_only"] },
    "access_status": { "type": "string", "enum": ["open_fixture", "local_authorized"] }
  }
}