{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH deidentified participant profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "participant_id", "data_origin", "questionnaire_language", "mother_tongues", "native_scripts", "script_proficiencies", "region_category", "cross_cultural_exposure", "training", "age_band", "education_level", "language_understood", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "study_id": { "$ref": "shared.schema.json#/$defs/id" },
    "participant_id": { "type": "string" },
    "data_origin": { "type": "string", "enum": ["synthetic", "real"] },
    "questionnaire_language": { "type": "string", "enum": ["zh-Hans", "en", "ja", "ko"] },
    "mother_tongues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bcp47", "dominance"],
        "properties": {
          "bcp47": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "dominance": { "type": "string", "enum": ["primary", "co_dominant", "additional"] }
        }
      }
    },
    "native_scripts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "shared.schema.json#/$defs/writingSystem" }
    },
    "script_proficiencies": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["script", "reading", "writing", "exposure_frequency"],
        "properties": {
          "script": { "type": "string", "enum": ["latin", "han", "kana", "hangul"] },
          "reading": { "type": "integer", "minimum": 1, "maximum": 7 },
          "writing": { "type": "integer", "minimum": 1, "maximum": 7 },
          "exposure_frequency": { "type": "integer", "minimum": 1, "maximum": 7 }
        }
      }
    },
    "region_category": { "type": "string", "enum": ["east_asia", "southeast_asia", "europe", "north_america", "south_america", "africa", "oceania", "west_central_asia", "multiple", "prefer_not_to_say", "other"] },
    "cross_cultural_exposure": { "type": "string", "enum": ["low", "moderate", "high", "prefer_not_to_say"] },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "typography", "calligraphy"],
      "properties": {
        "design": { "type": "string", "enum": ["none", "informal", "formal"] },
        "typography": { "type": "string", "enum": ["none", "informal", "formal"] },
        "calligraphy": { "type": "string", "enum": ["none", "informal", "formal"] }
      }
    },
    "age_band": { "type": "string", "enum": ["18_24", "25_34", "35_44", "45_54", "55_64", "65_plus", "prefer_not_to_say"] },
    "education_level": { "type": "string", "enum": ["secondary_or_less", "vocational", "undergraduate", "postgraduate", "prefer_not_to_say", "other"] },
    "language_understood": { "type": "boolean" },
    "created_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" }
  },
  "allOf": [
    {
      "if": { "properties": { "data_origin": { "const": "synthetic" } }, "required": ["data_origin"] },
      "then": { "properties": { "participant_id": { "pattern": "^synp_[a-z0-9_-]{4,63}$" } } },
      "else": { "properties": { "participant_id": { "pattern": "^p_[A-Za-z0-9_-]{2,63}$" } } }
    }
  ]
}