{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH immutable analysis run snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_run_id",
    "plan_revision_id",
    "plan_sha256",
    "input_artifacts",
    "handoffs",
    "module_descriptors",
    "rules",
    "software_environment",
    "random_seed",
    "data_origin",
    "gate_state",
    "created_at",
    "snapshot_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_run_id": { "type": "string", "pattern": "^analysis_[a-f0-9]{24}$" },
    "plan_revision_id": { "type": "string", "pattern": "^planrev_[a-f0-9]{24}$" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "handoffs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handoff_import_id", "task_id", "manifest_path", "manifest_sha256", "producer_commit"],
        "properties": {
          "handoff_import_id": { "type": "string" },
          "task_id": { "type": "string" },
          "manifest_path": { "type": "string" },
          "manifest_sha256": { "$ref": "#/$defs/sha256" },
          "producer_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    },
    "module_descriptors": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module_id", "descriptor_sha256"],
        "properties": {
          "module_id": { "type": "string" },
          "descriptor_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": ["inclusion", "exclusion", "missingness"],
      "properties": {
        "inclusion": { "type": "array" },
        "exclusion": { "type": "array" },
        "missingness": { "type": "array" }
      }
    },
    "software_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "python", "platform", "pyproject_sha256", "uv_lock_sha256", "runtime_lock_sha256"],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "python": { "type": "string" },
        "platform": { "type": "string" },
        "pyproject_sha256": { "$ref": "#/$defs/sha256" },
        "uv_lock_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_lock_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "random_seed": { "type": "integer", "minimum": 0 },
    "data_origin": { "enum": ["synthetic", "real"] },
    "gate_state": { "type": "array", "items": { "type": "object" } },
    "created_at": { "$ref": "shared.schema.json#/$defs/isoDateTime" },
    "snapshot_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "module_id", "logical_type", "path", "sha256", "data_classification"],
      "properties": {
        "artifact_id": { "type": "string" },
        "module_id": { "type": "string" },
        "logical_type": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "type": ["string", "null"] },
        "data_classification": { "type": "string" }
      }
    }
  }
}