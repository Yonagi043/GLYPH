{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLYPH frozen joint-analysis plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "status",
    "research_questions",
    "estimands",
    "outcomes",
    "analysis_unit",
    "inclusion_rules",
    "exclusion_rules",
    "stratification",
    "contrasts",
    "model",
    "features",
    "missingness",
    "multiple_comparisons",
    "sensitivity",
    "stopping_rule",
    "output_boundaries",
    "approval_history",
    "amendment_history"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "plan_id": { "type": "string", "pattern": "^plan_[a-z0-9_]{4,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "preregistered", "amended", "exploratory"] },
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "estimands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["estimand_id", "outcome", "description", "analysis_class"],
        "properties": {
          "estimand_id": { "type": "string", "pattern": "^estimand_[a-z0-9_]{2,63}$" },
          "outcome": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "analysis_class": { "enum": ["confirmatory", "exploratory", "engineering_fixture"] }
        }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "secondary": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "analysis_unit": { "const": "participant_x_stimulus_x_item" },
    "inclusion_rules": { "$ref": "#/$defs/nonEmptyStrings" },
    "exclusion_rules": { "$ref": "#/$defs/nonEmptyStrings" },
    "stratification": { "$ref": "#/$defs/nonEmptyStrings" },
    "contrasts": { "$ref": "#/$defs/nonEmptyStrings" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "family",
        "link",
        "backend",
        "optimizer",
        "random_effects",
        "clusters",
        "repeated_measures",
        "fixture_approximation"
      ],
      "properties": {
        "formula": { "type": "string", "minLength": 1 },
        "family": { "enum": ["ordinal", "continuous"] },
        "link": { "enum": ["logit", "probit", "identity"] },
        "backend": { "type": "string", "minLength": 1 },
        "optimizer": { "type": "string", "minLength": 1 },
        "random_effects": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["participant_id", "stimulus_id", "work_id", "character_id"] }
        },
        "clusters": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["participant_id", "stimulus_id", "work_id", "font_id", "thread_id"] }
        },
        "repeated_measures": { "type": "boolean", "const": true },
        "fixture_approximation": { "type": "string", "minLength": 1 }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "selection_timing",
        "scaling",
        "deprecated_scores_allowed"
      ],
      "properties": {
        "selection": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["feature_code", "representation", "normalization_profile"],
            "properties": {
              "feature_code": { "type": "string", "minLength": 1 },
              "representation": { "enum": ["A_layout", "B_shape", "C_ink"] },
              "normalization_profile": { "type": "string", "minLength": 1 }
            }
          }
        },
        "selection_timing": { "const": "frozen_before_outcomes" },
        "scaling": { "const": "training_fold_only" },
        "deprecated_scores_allowed": { "const": false }
      }
    },
    "missingness": { "$ref": "#/$defs/nonEmptyStrings" },
    "multiple_comparisons": { "type": "string", "minLength": 1 },
    "sensitivity": { "$ref": "#/$defs/nonEmptyStrings" },
    "stopping_rule": { "type": "string", "minLength": 1 },
    "output_boundaries": { "$ref": "#/$defs/nonEmptyStrings" },
    "approval_history": { "type": "array", "items": { "type": "object" } },
    "amendment_history": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}